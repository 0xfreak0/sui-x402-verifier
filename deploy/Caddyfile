# Caddy fronts the whole stack and handles TLS automatically.
#
# On first start it requests a Let's Encrypt certificate over HTTP-01, which is
# why port 80 must be open to the internet as well as 443. Renewal is automatic.

{
	email {$ACME_EMAIL}
}

(gateway_headers) {
	header_up X-Forwarded-For {remote_host}
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-Host {host}
	header_up X-Forwarded-Proto {scheme}
}

{$X402_DOMAIN} {
	# SECURITY BOUNDARY, for both upstreams below. `header_up` with a value
	# REPLACES the header, which is the point: a client-supplied
	# X-Forwarded-For is discarded here rather than carried inward, so nobody
	# can rotate it to mint themselves a fresh free-tier allowance. Envoy is
	# configured with xff_num_trusted_hops: 1 to read exactly this one hop.
	#
	# X-Forwarded-Host is what lets the gateway advertise a resource URL the
	# client can actually reach; without it the challenge names the internal
	# address Envoy was reached on.

	# Gated traffic goes STRAIGHT to the gateway. The demo backend is not in
	# this path and would not exist in a real deployment — routing through it
	# was what made the challenge advertise an internal address, and it made
	# the topology misrepresent the product.
	@gated path /graphql* /free/* /spin* /boom* /sui.rpc.v2.* /grpc.reflection.* /grpc.health.*
	handle @gated {
		reverse_proxy envoy:10000 {
			import gateway_headers
			# gRPC and grpc-web need HTTP/2 to the upstream. h2c because the
			# hop is inside the compose network and unencrypted.
			transport http {
				versions h2c 2
			}
		}
	}

	# Everything else is the demo: the page, the console API, and paying on a
	# visitor's behalf. `envoy` rather than `demo` as the hostname because the
	# demo shares Envoy's network namespace — see docker-compose.yml.
	handle {
		reverse_proxy envoy:8402 {
			import gateway_headers
			transport http {
				versions h2c 2
			}
		}
	}

	log {
		output stdout
		format console
	}
}
