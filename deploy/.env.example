# Copy to deploy/.env and fill in. NEVER commit the result — .env is gitignored.
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env

# Domain the demo is served from. Must already resolve to the VM's IP before
# starting the stack, or Caddy's ACME challenge fails and Let's Encrypt
# rate-limits the retries.
X402_DOMAIN=x402.example.com

# Let's Encrypt uses this for expiry warnings.
ACME_EMAIL=you@example.com

# ---- secrets ---------------------------------------------------------------

# Signs session tokens. Generate a FRESH one for the VM — do not reuse a local
# development value:
#   openssl rand -hex 32
# Rotating it invalidates every live session, which is the correct behaviour.
X402_SESSION_HMAC_SECRET=

# The demo wallet's private key, `suiprivkey1...`. This is the one genuinely
# sensitive value here: the process signs payments with it, so anyone who reads
# this file can spend the wallet.
#
# Fund it with trivial amounts and nothing else. Testnet USDC from
# https://faucet.circle.com (chain: Sui Testnet) is all it needs — settlement is
# gasless above 0.01 USDC, so the wallet holds no SUI and spends none. A little
# SUI is required only for the one-off transaction that moves the USDC into the
# wallet's address balance; see the funding section in the top-level README.
#
# USDC is the binding constraint: at the 0.01 floor, 20 USDC is ~2000 payments.
X402_SUI_PRIVATE_KEY=

# ---- receiving wallets -----------------------------------------------------

# Default payee, 0x + 64 hex characters. The service refuses to start on the
# zero address, so a missing value fails loudly at boot rather than settling
# somewhere wrong.
X402_PAY_TO=

# Payee for the gRPC policy. A SECOND, DIFFERENT wallet — the demo's point is
# that one gateway can credit unrelated sellers, and leaving this unset makes
# every route pay the same address.
X402_PAY_TO_GRPC=

# ---- spend controls --------------------------------------------------------

# Hard ceiling on paid requests for the lifetime of the demo process, and per
# visitor per hour. A public link can burn a wallet in an afternoon; these are
# the only thing standing between a Slack post and an empty wallet.
X402_MAX_PLAYS=400
X402_PLAYS_PER_IP=20

# Optional. x402_verifier=debug logs every authorization decision.
RUST_LOG=x402_verifier=info,x402_demo=info
