/target

# Local run artifacts
/.local-logs
/.local-logs-*.log

# Real configuration. Only config.example.yaml is tracked — a working config
# carries a receiving wallet and an HMAC secret, neither of which belongs in git.
/config.yaml
/config.*.yaml
!/config.example.yaml

.DS_Store

# Local working notes and parked deploy work — see LOCAL-NOTES.md.
# Deliberately untracked until the x402 conformance work lands; deploying a
# non-conformant demo would show clients something they cannot talk to.
/LOCAL-NOTES.md
/X402-CONFORMANCE-PROMPT.md
/Dockerfile
/.dockerignore
/deploy/
