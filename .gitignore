/target

# Local run artifacts
/.local-logs
/.local-logs-*.log

# Real configuration. Only config.example.yaml is tracked — a working config
# carries a receiving wallet and an HMAC secret, neither of which belongs in git.
/config.yaml
/config.*.yaml
!/config.example.yaml
# config.demo.yaml is tracked: it carries no wallet and no secret (both come
# from the environment), and it is the reference for the four-policy setup the
# demo runs on.
!/config.demo.yaml

.DS_Store

# The prize video. Someone else's copyrighted work, and there is no reason to
# redistribute it from this repo. Fetch or supply your own; the page degrades to
# a text card when it is absent.
/demo/rickroll.mp4

# Development scratch: session notes, design spikes, parked work, runbooks.
# Never committed. See CLAUDE.md for what belongs here versus in docs/.
/scratchpad/

/X402-CONFORMANCE-PROMPT.md

# The deploy stack IS tracked — it carries no secrets. The filled-in
# environment file is the one thing that must never be committed: it holds the
# session HMAC secret and the demo wallet's private key.
/deploy/.env
