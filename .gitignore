/target

# Local run artifacts
/.local-logs
/.local-logs-*.log

# Real configuration. Only config.example.yaml is tracked — a working config
# carries a receiving wallet and an HMAC secret, neither of which belongs in git.
/config.yaml
/config.*.yaml
!/config.example.yaml
# config.demo.yaml is tracked: it carries no wallet and no secret (both come
# from the environment), and it is the reference for the four-policy setup the
# demo runs on.
!/config.demo.yaml

.DS_Store

# Development scratch: session notes, design spikes, parked work, runbooks.
# Never committed. See CLAUDE.md for what belongs here versus in docs/.
/scratchpad/

/X402-CONFORMANCE-PROMPT.md
/Dockerfile
/.dockerignore
/deploy/
